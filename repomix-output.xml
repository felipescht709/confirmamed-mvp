<file path="backend/src/services/ia/edges/RoutingEdges.js">
/**
 * Arquivo central de Arestas Condicionais (Conditional Edges) do LangGraph.
 * Define o fluxo do autômato (FSM) avaliando o ConfirmaMedState.
 */

/**
 * 1. Roteamento de Entrada (Após o Gatekeeper)
 * Avalia se o paciente tem permissão de usar a IA.
 */
const routeFromGatekeeper = (state) => {
  // Se a sessão estiver com um atendente humano (TRANSBORDO)
  // ou se o paciente não aceitou a LGPD, aborta o fluxo da LLM e vai para Auditoria Final
  if (state.estadoSessao === "TRANSBORDO" || state.aceiteLgpd === false) {
    return "auditLogNode";
  }
  return "brainNode";
};

/**
 * 2. Roteamento da Inteligência (Após BrainNode / LLM Primária)
 * Avalia se a IA escolheu usar uma ferramenta ou se ela respondeu um texto final.
 */
const routeFromBrain = (state) => {
  const { messages } = state;
  const lastMessage = messages[messages.length - 1];

  // Verifica na BaseMessage do LangChain se o modelo invocou tools via 'bindTools'
  if (lastMessage?.tool_calls && lastMessage.tool_calls.length > 0) {
    return "tools"; // Roteia para o utilitário ToolNode nativo
  }

  // Se não tem tool_call, significa que a IA gerou o texto final. Roteia para o Auditor Clínico.
  return "supervisorNode";
};

/**
 * 3. Guardião Anti-Loop (Após execução de Ferramentas)
 * Substitui o antigo (depth > 3). Previne que a IA chame a mesma Tool eternamente em caso de erro técnico.
 */
const routeFromTools = (state) => {
  const { messages } = state;

  // Se o histórico de mensagens da sessão atual ultrapassar um limite seguro (ex: 12 saltos)
  // Assumimos que a IA está presa num loop de tentativas e falhas com o Banco de Dados.
  if (messages.length > 12) {
    console.warn(
      "⚠️ [Anti-Loop Guard] LLM presa em Loop de Tools. Forçando interrupção via Fallback.",
    );
    return "fallbackNode"; // Roteia para o Gemini para gerar uma desculpa técnica e quebrar o loop
  }

  // Ciclo normal: Ferramenta executou, volta para o BrainNode ler o resultado do Banco
  return "brainNode";
};

module.exports = {
  routeFromGatekeeper,
  routeFromBrain,
  routeFromTools,
};
</file>

<file path="backend/src/services/ia/nodes/AuditLogNode.js">
const db = require("../../../database/db");

/**
 * Audit Log Node (Rastreabilidade - ISO/IEC 42001)
 * Este nó é sempre o último a ser executado antes da devolução da resposta.
 * Ele pega o estado final do StateGraph e materializa no PostgreSQL.
 */
const auditLogNode = async (state) => {
  const { messages, iso_audit_trail } = state;

  // Recupera o input inicial e o output final
  const inputUsuario =
    messages
      .slice()
      .reverse()
      .find((m) => m._getType() === "human")?.content || "";
  const outputIa =
    messages
      .slice()
      .reverse()
      .find((m) => m._getType() === "ai" && m.content)?.content || "";

  try {
    // Gravação unificada na tabela de auditoria
    await db("ai_audit_logs").insert({
      input_usuario: inputUsuario,
      output_ia: outputIa,
      provider_usado: iso_audit_trail?.provider_used || "OPENAI",
      veredicto_auditoria: iso_audit_trail?.auditoria_reprovada
        ? "REPROVADO"
        : "APROVADO",
      risco_detectado: iso_audit_trail?.risco_detectado || null,
      prompt_hash: iso_audit_trail?.prompt_hash || "v3.0-langgraph",
      data_hora: new Date(),
    });
  } catch (error) {
    console.error(
      "❌ [AuditLogNode] Falha Crítica ao salvar rastreabilidade:",
      error,
    );
  }

  return {}; // Nó terminal de persistência, não precisa mutar o estado do LangGraph
};

module.exports = auditLogNode;
</file>

<file path="backend/src/services/ia/nodes/BrainNode.js">
const { ChatOpenAI } = require("@langchain/openai");
const { confirmamedTools } = require("../tools");

/**
 * Brain Node (IA Primária - OpenAI)
 * Avalia o contexto e decide se responde diretamente ao usuário ou se invoca uma Tool.
 */
const brainNode = async (state, config) => {
  const { messages } = state;

  // Instancia a OpenAI com os parâmetros estritos da arquitetura
  // maxRetries configurado baixo (1) para falhar rápido e acionar o Fallback (Circuit Breaker)
  const llm = new ChatOpenAI({
    modelName: "gpt-4o",
    temperature: 0.3,
    maxRetries: 1,
  }).bindTools(confirmamedTools);

  // Invoca o modelo passando as mensagens
  const response = await llm.invoke(messages, config);

  // O reducer do ConfirmaMedState automaticamente fará o append desta nova AIMessage ao array
  return {
    messages: [response],
    iso_audit_trail: { provider_used: "OPENAI" },
    tentativasErro: 0, // Reseta contador de erros se teve sucesso
  };
};

module.exports = brainNode;
</file>

<file path="backend/src/services/ia/nodes/FallbackNode.js">
const { ChatGoogleGenerativeAI } = require("@langchain/google-genai");
const { confirmamedTools } = require("../tools");

/**
 * Fallback Node (IA Secundária - Gemini)
 * Invocado SOMENTE se o BrainNode falhar. Garante a resiliência e a alta disponibilidade (Failover).
 */
const fallbackNode = async (state, config) => {
  const { messages } = state;

  console.warn(
    "⚠️ [Failover Ativado] OpenAI falhou. Redirecionando requisição para Gemini Flash.",
  );

  // Instancia o Gemini como Backup.
  // A SDK moderna do Google suporta bindTools exatamente igual a OpenAI.
  const llm = new ChatGoogleGenerativeAI({
    modelName: "gemini-1.5-flash",
    temperature: 0.3,
    maxRetries: 1,
  }).bindTools(confirmamedTools);

  // Invoca o modelo
  const response = await llm.invoke(messages, config);

  // Registramos explicitamente no rastro de auditoria que o Fallback foi usado
  return {
    messages: [response],
    iso_audit_trail: { provider_used: "GEMINI" },
    tentativasErro: 0,
  };
};

module.exports = fallbackNode;
</file>

<file path="backend/src/services/ia/nodes/GatekeeperNode.js">
const SessionService = require("../../core/SessionService");
const piiMasker = require("../security/PIIMasker");

/**
 * Gatekeeper Node
 * Responsável por Inicialização de Sessão, Controle de LGPD e Anonimização (PII Masking).
 * @param {import("../state/ConfirmaMedState").ConfirmaMedState} state - O estado atual do Grafo
 */
const gatekeeperNode = async (state) => {
  const { telefoneOrigem, unidadeId, messages, iso_audit_trail } = state;

  // 1. Busca ou Cria a Sessão (FSM - Finite State Machine)
  const session = await SessionService.getOrCreateSession(
    telefoneOrigem,
    unidadeId,
  );

  // 2. Proteção LGPD: PII Masking nas mensagens recentes (Human Messages)
  // Como LangGraph trabalha com array de objetos BaseMessage, interceptamos a última mensagem.
  const lastMessage = messages[messages.length - 1];

  if (lastMessage && lastMessage._getType() === "human") {
    const originalContent = lastMessage.content;

    // Passa o texto pelo PIIMasker para remover CPFs, emails, etc.
    const maskedContent = piiMasker.mask(originalContent);

    // Se houve alteração, atualizamos o conteúdo para a LLM não receber o dado puro
    if (originalContent !== maskedContent) {
      lastMessage.content = maskedContent;
    }
  }

  // 3. Atualiza o Estado Global com as regras da sessão e métricas de compliance
  return {
    // Propriedades do Banco
    estadoSessao: session.estado_atual || "ATIVO",
    aceiteLgpd: session.aceite_lgpd || false,

    // Atualiza metadados da ISO 42001 (AIMS)
    iso_audit_trail: {
      pii_masked: true,
      human_override: session.estado_atual === "TRANSBORDO", // Ativa flag se a sessão já estiver para um humano
    },

    // Nota: Nenhuma nova mensagem é retornada porque já mutamos 'lastMessage' in-place (permitido para nodes de entrada).
  };
};

module.exports = gatekeeperNode;
</file>

<file path="backend/src/services/ia/nodes/SupervisorNode.js">
const { ChatGoogleGenerativeAI } = require("@langchain/google-genai");
const { z } = require("zod");

/**
 * Supervisor Node (Auditor Clínico - Gemini)
 * Avalia a resposta gerada pela LLM Primária para garantir que não haja alucinação
 * ou risco clínico antes de enviar ao paciente (Human-in-the-loop / ISO 42001).
 */
const supervisorNode = async (state) => {
  const { messages } = state;
  const lastMessage = messages[messages.length - 1];

  // Se a mensagem for uma Tool Call (IA decidiu chamar o banco de dados),
  // não auditamos o texto, pois a ação interna já é fechada pelas restrições do Knex.
  if (lastMessage.tool_calls && lastMessage.tool_calls.length > 0) {
    return { iso_audit_trail: { auditoria_reprovada: false } };
  }

  // Recupera a mensagem original do paciente e a resposta gerada pela IA
  const humanMessage =
    messages
      .slice()
      .reverse()
      .find((m) => m._getType() === "human")?.content || "";
  const aiResponse = lastMessage.content || "";

  // Instancia o Gemini como Avaliador (Temperatura 0 para avaliação estrita)
  const llm = new ChatGoogleGenerativeAI({
    modelName: "gemini-1.5-flash",
    temperature: 0.0,
  });

  // Força o Gemini a responder num formato JSON estrito
  const auditorLlm = llm.withStructuredOutput(
    z.object({
      aprovado: z
        .boolean()
        .describe(
          "True se a resposta for segura, ética e não inventar procedimentos médicos.",
        ),
      risco_detectado: z
        .string()
        .describe(
          "Se reprovado, descreva brevemente o risco. Se aprovado, deixe vazio.",
        ),
      nivel_risco: z
        .enum(["LOW", "MEDIUM", "HIGH"])
        .describe("Nível de gravidade clínica da interação."),
    }),
  );

  const prompt = `Você é um Auditor Clínico Nível 3 focando na norma ISO/IEC 42001 de IAs.
Analise se a IA de atendimento cometeu um erro ao responder o paciente.
Regras de Reprovação: 1. Prescreveu remédio. 2. Inventou preparo de exame da cabeça dela. 3. Deu diagnóstico.
Entrada do Paciente: "${humanMessage}"
Resposta da IA de Atendimento: "${aiResponse}"`;

  const avaliacao = await auditorLlm.invoke(prompt);

  return {
    iso_audit_trail: {
      auditoria_reprovada: !avaliacao.aprovado,
      risco_detectado: avaliacao.risco_detectado || null,
      risk_level: avaliacao.nivel_risco,
    },
  };
};

module.exports = supervisorNode;
</file>

