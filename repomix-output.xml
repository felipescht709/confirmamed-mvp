      - VITE_API_URL=http://localhost:4000/api
    volumes:
      - ./frontend:/home/node/app
      - /home/node/app/node_modules
    depends_on:
      - backend
    networks:
      - confirmamed_net
    stdin_open: true
    tty: true

  # --- TÚNEL PARA WEBHOOKS ---
  ngrok:
    image: ngrok/ngrok:latest
    container_name: confirmamed_ngrok
    restart: unless-stopped
    command:
      - http
      - backend:4000
      - --url=carlo-unquarried-jenell.ngrok-free.dev
    environment:
      - NGROK_AUTHTOKEN=${token_ngrok:?erro_token_ausente}
    depends_on:
      - backend
    networks:
      - confirmamed_net

networks:
  confirmamed_net:
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: "1350"
  ngrok_net:
    # Define ngrok network for unified webhooks
    driver: bridge

volumes:
  pgdata:
  redis_data:
    driver: local
  evolution_sessoes:
    driver: local
