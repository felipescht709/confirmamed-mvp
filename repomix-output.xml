//services/ia/providers/GeminiProvider.js
const { GoogleGenerativeAI } = require("@google/generative-ai");

class GeminiProvider {
  constructor() {
    this.genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);
    // Alteração: Usar a tag 'latest' para evitar falhas de versão na API v1beta
    this.model = this.genAI.getGenerativeModel({ model: "gemini-2.5-flash" });
  }

  async generateResponse(systemPrompt, userMessage, tools = []) {
    try {
      // Melhoria: Instrução de fallback explícita
      const prompt = `SYSTEM: ${systemPrompt}\n\nUSER: ${userMessage}\n\nResponda como assistente da clínica:`;
      const result = await this.model.generateContent(prompt);
      return result.response.text();
    } catch (error) {
      console.error("Erro Gemini Fallback:", error.message);
      throw error;
    }
  }

  async auditResponse(regras, inputUsuario, acaoProposta) {
    try {
      // Cria a instância isolada do modelo para a auditoria
      const auditModel = this.genAI.getGenerativeModel({
        model: "gemini-2.5-flash",
      });

      const prompt = `
        VOCÊ É UM AUDITOR DE COMPLIANCE MÉDICO.
        REGRAS DA CLÍNICA: "${regras}"
        MENSAGEM DO USUÁRIO: "${inputUsuario}"
        AÇÃO PROPOSTA PELA IA: "${typeof acaoProposta === "string" ? acaoProposta : JSON.stringify(acaoProposta)}"

        A ação viola alguma regra de segurança, privacidade (LGPD) ou é clinicamente perigosa?
        Responda OBRIGATORIAMENTE em JSON puro:
        { "aprovado": boolean, "risco": "motivo em português ou null" }
      `;

      const result = await auditModel.generateContent(prompt);
      const text = result.response.text();

      // Limpeza de possíveis markdown na resposta do Gemini
      const cleanJson = text
        .replace(/```json/g, "")
        .replace(/```/g, "")
        .trim();
      return JSON.parse(cleanJson);
    } catch (error) {
      console.error("Erro Auditoria Gemini:", error.message);
      return { aprovado: true, risco: "Auditoria ignorada por erro técnico" };
    }
  }
}

module.exports = GeminiProvider;
</file>

<file path="backend/src/services/ia/state/ConfirmaMedState.js">
const { Annotation } = require("@langchain/langgraph");

/**
 * Definição do Estado Global do LangGraph (StateGraph)
 * Adere à LGPD (Minimização de Dados) e ISO/IEC 42001 (AIMS)
 */
const ConfirmaMedState = Annotation.Root({
  // 1. MEMÓRIA TRANSACIONAL (Core LangGraph)
  // O reducer concatena novas mensagens ao histórico dinamicamente
  messages: Annotation({
    reducer: (currentState, updateValue) => currentState.concat(updateValue),
    default: () => [],
  }),

  // 2. IDENTIDADE E MULTI-TENANCY (Business Core)
  telefoneOrigem: Annotation({ default: () => null }),
  unidadeId: Annotation({ default: () => null }),
  pacienteId: Annotation({ default: () => null }), // null se for usuário novo

  // 3. MÁQUINA DE ESTADOS (Controle de Fluxo)
  estadoSessao: Annotation({ default: () => "ATIVO" }), // ATIVO, TRANSBORDO, TRIAGEM, CONFIRMACAO
  aceiteLgpd: Annotation({ default: () => false }),

  // 4. COMPLIANCE ISO/IEC 42001 & SEGURANÇA
  iso_audit_trail: Annotation({
    // Atualiza apenas as chaves enviadas (merge)
    reducer: (currentState, updateValue) => ({ ...currentState, ...updateValue }),
    default: () => ({
      prompt_hash: null,          // Rastreabilidade: Hash do System Prompt usado
      risk_level: "LOW",          // LOW, MEDIUM, HIGH (Ex: HIGH se for emergência médica)
      pii_masked: true,           // Validação de Minimização de Dados Ativa
      human_override: false,      // Flag ativada quando entra no Transbordo (Human-in-the-loop)
      provider_used: "OPENAI",    // OPENAI ou GEMINI (Fallback)
      auditoria_reprovada: false  // Se o nó do Gemini Auditor barrar a resposta
    }),
  }),

  // 5. TELEMETRIA E PREVENÇÃO DE LOOP INFINITO
  tentativasErro: Annotation({
    reducer: (currentState, updateValue) => currentState + updateValue,
    default: () => 0,
  }),
});

module.exports = { ConfirmaMedState };
</file>

