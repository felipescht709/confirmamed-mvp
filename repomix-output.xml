import React, { useState, useEffect, useRef } from "react";
import api from "../../services/api";
import { Send, Bot, User, Loader2 } from "lucide-react";

const WebChatWidget = ({ sessionId: externalSessionId, isAdmin = false, unidadeId }) => {
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [fetchingHistory, setFetchingHistory] = useState(false);

  const sessionId = externalSessionId;

  const scrollRef = useRef();
  
  useEffect(() => {
    if (scrollRef.current)
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
  }, [messages, loading]);

  // Carregar histórico quando o sessionId mudar
  useEffect(() => {
    if (sessionId) {
      fetchHistory();
    }
  }, [sessionId]);

  const fetchHistory = async () => {
    try {
      setFetchingHistory(true);
      // Usamos o endpoint de auditoria ou um específico de histórico se houver
      // Para o admin, podemos usar o /ia/audit-logs
      const endpoint = isAdmin 
        ? `/ia/audit-logs?session_id=${sessionId}`
        : `/public/chat/${sessionId}`; // Se for público (mas aqui estamos no admin)

      // Na verdade, se estamos no Monitor, somos Admin.
      const { data } = await api.get(`/ia/audit-logs?session_id=${sessionId}`);
      
      // Mapear logs de auditoria para o formato de mensagens do chat
      const history = data.reverse().map(log => {
        const msgs = [];
        if (log.input_usuario && log.input_usuario !== "[SISTEMA]" && log.input_usuario !== "[ADMIN]") {
          msgs.push({ role: "user", text: log.input_usuario });
        } else if (log.input_usuario === "[ADMIN]") {
            // Se o admin mandou, ele aparece do lado direito (como se fosse o "user" do monitor)
            // Ou talvez queiramos diferenciar.
        }

        if (log.output_ia) {
          msgs.push({ 
            role: log.provider_usado === "HUMAN_OPERATOR" ? "admin" : "assistant", 
            text: log.output_ia 
          });
        }
        return msgs;
      }).flat();

      setMessages(history);
    } catch (err) {
      console.error("Erro ao carregar histórico:", err);
    } finally {
      setFetchingHistory(false);
    }
  };

  const handleSend = async () => {
    if (!input.trim() || loading) return;
    const text = input;
    setInput("");
    
    // Otimista: adiciona a mensagem na tela
    setMessages((prev) => [...prev, { role: isAdmin ? "admin" : "user", text }]);
    setLoading(true);

    try {
      if (isAdmin) {
        // Enviar como Admin (Intervenção)
        await api.post(`/ia/chat/${sessionId}/send`, {
          messageText: text
        });
      } else {
        // Enviar como IA (Redundância Web)
        const { data } = await api.post("/ai/analyze", {
          messageText: text,
          clientId: sessionId,
          unidadeId: unidadeId,
        });
        setMessages((prev) => [
          ...prev,
          { role: "assistant", text: data.response },
        ]);
      }
    } catch (err) {
      setMessages((prev) => [
        ...prev,
        { role: "assistant", text: "Erro na conexão. Tente novamente." },
      ]);
    } finally {
      setLoading(false);
    }
  };

  if (fetchingHistory) {
    return (
      <div className="flex-1 flex items-center justify-center bg-slate-50">
        <Loader2 className="animate-spin text-brand-blue" size={32} />
      </div>
    );
  }

  return (
    <div className="flex flex-col h-full bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
      {/* Header opcional ou título */}
      <div className="bg-slate-50 border-b border-slate-200 p-4 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="w-8 h-8 bg-brand-blue/10 rounded-full flex items-center justify-center">
            <Bot size={18} className="text-brand-blue" />
          </div>
          <div>
            <h3 className="text-sm font-bold text-slate-700">Canal de Atendimento</h3>
            <p className="text-[10px] text-slate-400 uppercase font-black tracking-widest">
              Sessão: {sessionId?.substring(0, 8)}...
            </p>
          </div>
        </div>
      </div>

      {/* Mensagens */}
      <div
        ref={scrollRef}
        className="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50"
      >
        {messages.map((m, i) => (
          <div
            key={i}
            className={`flex ${m.role === "user" ? "justify-start" : "justify-end"}`}
          >
            <div className={`flex gap-2 max-w-[85%] ${m.role === "user" ? "flex-row" : "flex-row-reverse"}`}>
                <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 ${
                    m.role === "user" ? "bg-slate-200 text-slate-600" : 
                    m.role === "admin" ? "bg-amber-500 text-white" : "bg-brand-blue text-white"
                }`}>
                    {m.role === "user" ? <User size={14} /> : <Bot size={14} />}
                </div>
                <div
                    className={`p-3 rounded-2xl text-sm shadow-sm ${
                        m.role === "user"
                        ? "bg-white border border-slate-200 text-slate-700 rounded-tl-none"
                        : m.role === "admin"
                        ? "bg-amber-500 text-white rounded-tr-none"
                        : "bg-brand-blue text-white rounded-tr-none"
                    }`}
                >
                    {m.text}
                </div>
            </div>
          </div>
        ))}
        {loading && (
          <div className="flex justify-end">
            <div className="text-[10px] text-slate-400 animate-pulse font-bold uppercase tracking-widest">
                Enviando...
            </div>
          </div>
        )}
      </div>

      {/* Input */}
      <div className="p-4 bg-white border-t border-slate-200">
        <div className="flex gap-2">
            <input
                className="flex-1 text-sm p-3 bg-slate-100 rounded-xl outline-none focus:ring-2 focus:ring-brand-blue/20 transition-all"
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && handleSend()}
                placeholder="Digite sua mensagem..."
                disabled={loading}
            />
            <button
                onClick={handleSend}
                disabled={!input.trim() || loading}
                className="bg-brand-blue text-white p-3 rounded-xl hover:bg-opacity-90 transition-all disabled:opacity-50 shadow-lg shadow-brand-blue/10"
            >
                <Send size={18} />
            </button>
        </div>
      </div>
    </div>
  );
};

export default WebChatWidget;
</file>

