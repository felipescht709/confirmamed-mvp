// src/services/whatsapp/whatsappService.js
const axios = require("axios");

class WhatsAppService {
  constructor() {
    this.baseUrl = process.env.WHATSAPP_BASE_URL || "http://evolution:8080";
    this.globalToken = process.env.AUTHENTICATION_API_KEY || "admin123"; // Conforme seu docker-compose
  }

  /**
   * Envia uma mensagem de texto simples com mecanismo de retentativa
   */
  async sendTextMessage(to, message, instanceName) {
    if (!instanceName) throw new Error("instanceName é obrigatório");

    const phone = to.replace(/\D/g, "");
    const url = `${this.baseUrl}/message/sendText/${instanceName}`;
    
    // Configuração de retentativa (3 vezes para erros temporários 502/504)
    let attempts = 0;
    while (attempts < 3) {
      try {
        const response = await axios.post(
          url,
          { number: phone, text: message, delay: 1200 },
          {
            headers: {
              apikey: this.globalToken,
              "Content-Type": "application/json",
            },
            timeout: 15000, 
          }
        );

        console.log(`✅ [WhatsApp] Mensagem enviada para ${to} [Instance: ${instanceName}]`);
        return response.data;
      } catch (error) {
        attempts++;
        const status = error.response?.status;
        
        // Se for 502 ou 504 (timeout de rede/docker), tentamos de novo
        if ((status === 502 || status === 504) && attempts < 3) {
          console.warn(`[WhatsApp Retry] Instância ${instanceName} ocupada (Erro ${status}). Tentativa ${attempts}/3...`);
          await new Promise(r => setTimeout(r, 2000 * attempts));
          continue;
        }

        console.error(`❌ [WhatsApp Error] Falha fatal na instância ${instanceName}:`, error.response?.data || error.message);
        throw new Error(`Falha no envio via Evolution API: ${status || "Timeout"}`);
      }
    }
  }

  /**
   * Verifica se a instância está conectada e saudável
   */
  async checkInstanceStatus(instanceName) {
    try {
      const response = await axios.get(`${this.baseUrl}/instance/connectionState/${instanceName}`, {
        headers: { apikey: this.globalToken }
      });
      return response.data;
    } catch (e) {
      return { instance: { state: "disconnected" } };
    }
  }
}

module.exports = new WhatsAppService();
</file>

<file path="docker-compose.yml">
services:
  # --- INFRA E DATABASE ---
  db:
    image: postgres:15
    container_name: confirmamed_db
    restart: always
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}" ]
      interval: 5s
      timeout: 5s
      retries: 10
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./backup_utf8.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - confirmamed_net

  redis:
    image: redis:6.2-alpine
    container_name: confirmamed_redis
    restart: unless-stopped
    # 🔒 Segurança: Exige senha e define política de despejo de memória (Allkeys-lru)
    command: redis-server --requirepass ${REDIS_PASSWORD:-senha_segura_aqui} --maxmemory 256mb --maxmemory-policy allkeys-lru
    ports:
      - "6379:6379" # Mapeado para você conseguir inspecionar com o Redis Insight na sua máquina local
    networks:
      - confirmamed_net
    volumes:
      - redis_data:/data

  # --- WHATSAPP ENGINE (EVOLUTION API) ---
  evolution:
    image: evoapicloud/evolution-api:v2.3.7
    container_name: evolution_api
    restart: always
    privileged: true
    user: "root"
    shm_size: '2gb'
    dns:
      - 172.16.154.14
      - 8.8.8.8
      - 1.1.1.1
    environment:
      - AUTHENTICATION_TYPE=apikey
      - AUTHENTICATION_API_KEY=admin123
      - SERVER_TYPE=http
      - SERVER_PORT=8080
      - DATABASE_ENABLED=true
      - DATABASE_PROVIDER=postgresql
      - DATABASE_CONNECTION_URI=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=evolution&sslmode=disable
      - DATABASE_CONNECTION_CLIENT_NAME=confirmamed_evo
      # Variáveis de persistência v2
      - DATABASE_SAVE_DATA_INSTANCE=true
      - DATABASE_SAVE_DATA_NEW_MESSAGE=true
      - DATABASE_SAVE_DATA_CONTACTS=true
      - DATABASE_SAVE_DATA_CHATS=true
      - DATABASE_SAVE_INSTANCE=true
      - CACHE_REDIS_ENABLED=true
      - CACHE_REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379/1
      - CACHE_REDIS_PREFIX_KEY=evolution_v2
      - LOG_LEVEL=DEBUG,INFO,ERROR,WARN
      - WEB_BROWSER_HEADLESS=true
      # Argumentos simplificados para evitar crash de engine
      - WEB_BROWSER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
      # Novas Variáveis de Estabilidade (v2.4.1)
      - WA_BUSINESS_COMPLIANCE=false
      - CONFIG_SESSION_CHAT_SYNC=false
      - WEB_BROWSER_CONFIG_SKIP_BROWSERS_CHECK=true
      # Dashboard Evolution v2
      - DASHBOARD_ENABLED=${DASHBOARD_ENABLED:-true}
      - DASHBOARD_USER=${DASHBOARD_USER:-admin}
      - DASHBOARD_PASSWORD=${DASHBOARD_PASSWORD:-admin123}
      # Configuração de Webhook Global (Ponta de Retorno)
      - WEBHOOK_GLOBAL_URL=http://backend:4000/api/webhooks/whatsapp
      - WEBHOOK_GLOBAL_ENABLED=true
      - WEBHOOK_EVENTS_MESSAGES_UPSERT=true
      - WEBHOOK_EVENTS_APPLICATION_STARTUP=true
      - WEBHOOK_EVENTS_QRCODE_UPDATED=true
      - WEBHOOK_EVENTS_MESSAGES_UPDATE=true
      # URL externa para a Evolution se reconhecer
      - SERVER_URL=${SERVER_URL:-http://localhost:8085}
    ports:
      - "8085:8080"
    healthcheck:
      test: [ "CMD", "wget", "--no-verbose", "--tries=1", "--spider", "--header=apikey: admin123", "http://localhost:8080/instance/fetchInstances" ]
      interval: 10s
      timeout: 5s
      retries: 5
    depends_on:
      db:
        condition: service_healthy
    volumes:
      - evolution_sessoes:/evolution/instances
    networks:
      confirmamed_net:
        aliases:
          - evolution
          - ngrok_net

  # --- NOSSA APLICAÇÃO ---
  backend:
    build: ./backend
    container_name: confirmamed_api
    dns:
      - 172.16.154.14
      - 8.8.8.8
      - 1.1.1.1
    env_file: .env
    ports:
