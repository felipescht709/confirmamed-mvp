<file path="backend/scripts/chat-test.js">
#!/usr/bin/env node
// scripts/chat-test.js
// ──────────────────────────────────────────────────────────────────────────
// CLI para testar a IA sem precisar do WhatsApp.
// Simula exatamente o mesmo fluxo do whatsappController.js.
// ──────────────────────────────────────────────────────────────────────────

require("dotenv").config({ path: require("path").resolve(__dirname, "../.env") });

const readline = require("readline");
const AIOrchestrator  = require("../src/services/ia/AIOrchestrator");
const SessionService  = require("../src/services/core/SessionService");
const RedisService    = require("../src/services/core/RedisService");

// ── Argumentos ────────────────────────────────────────────────────────────
const args = process.argv.slice(2);
const getArg = (flag) => {
  const i = args.indexOf(flag);
  return i !== -1 ? args[i + 1] : null;
};

const UNIDADE_ID  = parseInt(getArg("--unidade") || "4", 10);
const PHONE       = getArg("--phone") || "5500000000000"; // telefone fictício
const RESET       = args.includes("--reset");
const SINGLE_MSG  = getArg("--message");

// ── Cores ─────────────────────────────────────────────────────────────────
const CYAN   = "\x1b[36m";
const GREEN  = "\x1b[32m";
const YELLOW = "\x1b[33m";
const RED    = "\x1b[31m";
const DIM    = "\x1b[2m";
const RESET_COLOR = "\x1b[0m";
const BOLD   = "\x1b[1m";

const orchestrator = new AIOrchestrator();

function printHeader() {
  console.log(`\n${BOLD}${CYAN}╔══════════════════════════════════════════════════╗`);
  console.log(`║       ConfirmaMED — Simulador de Chat IA         ║`);
  console.log(`╚══════════════════════════════════════════════════╝${RESET_COLOR}`);
  console.log(`${DIM}  Unidade ID : ${UNIDADE_ID}`);
  console.log(`  Telefone   : ${PHONE}`);
  console.log(`  Comandos: /sair | /reset | /sessao${RESET_COLOR}\n`);
}

async function showSession() {
  try {
    const session = await SessionService.getOrCreateSession(PHONE, UNIDADE_ID);
    console.log(`${DIM}[Sessão] ID: ${session.session_id} | Estado: ${session.estado_atual} | LGPD: ${session.aceite_lgpd}${RESET_COLOR}`);
  } catch (e) {
    console.log(`${DIM}[Sessão] Erro: ${e.message}${RESET_COLOR}`);
  }
}

async function resetSession() {
  try {
    const piiMasker = require("../src/services/ia/security/PIIMasker");
    await piiMasker.purge(PHONE);
    const knex = require("../src/database/db");
    await knex("chat_sessions").where({ telefone: PHONE, unidade_id: UNIDADE_ID }).delete();
    console.log(`${YELLOW}🗑️ Sessão resetada.${RESET_COLOR}`);
  } catch (e) {
    console.log(`${RED}Erro reset: ${e.message}${RESET_COLOR}`);
  }
}

let memoryHistory = [];

async function processInput(input) {
  const startMs = Date.now();
  try {
    const result = await orchestrator.processMessage(
      { body: input, history: memoryHistory },
      UNIDADE_ID,
      PHONE
    );
    const latency = Date.now() - startMs;
    const text = result?.text || result || "(vazio)";
    
    // Atualiza histórico local para a próxima iteração
    memoryHistory.push({ role: "user", content: input });
    memoryHistory.push({ role: "assistant", content: text });
    if (memoryHistory.length > 10) memoryHistory = memoryHistory.slice(-10);

    console.log(`\n${CYAN}IA [${latency}ms] > ${RESET_COLOR}${text}\n`);
  } catch (err) {
    console.log(`\n${RED}❌ Erro: ${err.message}${RESET_COLOR}\n`);
  }
}

async function main() {
  if (RESET) {
    await resetSession();
    memoryHistory = [];
  }

  if (SINGLE_MSG) {
    await processInput(SINGLE_MSG);
    await RedisService.getClient().quit().catch(() => {});
    process.exit(0);
  }

  printHeader();
  await showSession();

  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, prompt: `${GREEN}Você > ${RESET_COLOR}` });
  rl.prompt();

  rl.on("line", async (line) => {
    const input = line.trim();
    if (!input) { rl.prompt(); return; }
    if (input === "/sair") rl.close();
    else if (input === "/reset") { 
      await resetSession(); 
      memoryHistory = [];
      rl.prompt(); 
    }
    else if (input === "/sessao") { await showSession(); rl.prompt(); }
    else {
        console.log(`${DIM}  ⏳ processando...${RESET_COLOR}`);
        await processInput(input);
        rl.prompt();
    }
  });

  rl.on("close", async () => {
    await RedisService.getClient().quit().catch(() => {});
    process.exit(0);
  });
}

main().catch(err => { console.error(err); process.exit(1); });
