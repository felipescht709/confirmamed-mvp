          .select("p.id_profissional_saude", "p.nome_completo", "p.especialidade"),

        knex("procedimentos")
          .where({ unidade_id, ativo: true, tipo: "CONSULTA" })
          .select("nome_procedimento", "valor"),

        knex("convenios")
          .where("ativo", true)
          .select("nome")
      ]);

      if (!unidade) return "Erro: Unidade não encontrada.";

