const { DynamicStructuredTool } = require("@langchain/core/tools");
const { z } = require("zod");
const db = require("../../../database/db");

/**
 * SchedulingTool - Efetivação de Agendamento
 * Possui controle de concorrência com travas para evitar Overbooking de Slots.
 */
const schedulingTool = new DynamicStructuredTool({
  name: "agendar_consulta",
  description:
    "Realiza a gravação do agendamento no banco de dados. Só acione após a confirmação do horário pelo paciente.",
  schema: z.object({
    paciente_id: z.number().describe("ID do paciente"),
    profissional_id: z.number().describe("ID do médico ou sala"),
    unidade_id: z.number().describe("ID da unidade de atendimento"),
    data_hora_inicio: z
      .string()
      .describe("Data e hora no formato ISO 8601 (Ex: 2026-03-02T14:00:00Z)"),
  }),
  func: async ({
    paciente_id,
    profissional_id,
    unidade_id,
    data_hora_inicio,
  }) => {
    try {
      // Anti-concorrência: Bloqueia Overbooking se o horário acabou de ser pego na fila web
      const conflito = await db("consultas")
        .where({ profissional_id, data_hora_inicio, status: "AGENDADO" })
        .first();

      if (conflito) {
        return "ERRO DE CONCORRÊNCIA: Este horário acabou de ser reservado por outra pessoa. Ofereça outro horário imediatamente.";
      }

      // Efetiva a gravação
      const [retorno] = await db("consultas")
        .insert({
          paciente_id,
          profissional_id,
          unidade_id,
          data_hora_inicio,
          status: "AGENDADO",
          tipo_pagamento: "PARTICULAR",
        })
        .returning("id_consulta");

      return `SUCESSO! Consulta gravada. O ID gerado é ${retorno.id_consulta || retorno}. Emita a mensagem final de confirmação de agenda.`;
    } catch (error) {
      return "Falha grave no banco de dados. Transfira para a equipe de recepção.";
    }
  },
});

module.exports = schedulingTool;
</file>

